# The address of the API, e.g. api.example.com. Its DNS must point at this server.
DOMAIN=

# openssl rand -hex 32    (a separate value for each)
DB_PASSWORD=
JWT_ACCESS_SECRET=

# Any email provider's SMTP address; percent-encode special characters in the password.
# SMTP_URL=smtps://user:password@smtp.example.com:465
SMTP_URL=
MAIL_FROM="Raf <no-reply@example.com>"

# Shown on /privacy, /terms and /delete-account: legal name and address, and an address you read.
LEGAL_OPERATOR=""
SUPPORT_EMAIL=

# Optional. Google sign-in: OAuth client ids, comma-separated.
GOOGLE_CLIENT_IDS=
# Optional. CPU threads the receipt reader uses; all of them when empty.
OCR_THREADS=
# Optional. A hosted database instead of the one here.
# DATABASE_URL=
