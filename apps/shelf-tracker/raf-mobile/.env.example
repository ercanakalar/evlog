# Address of the Raf API as seen from the phone.
# Android emulator: http://10.0.2.2:3100   iOS simulator: http://localhost:3100
# Physical device: http://<your-computer-LAN-IP>:3100
EXPO_PUBLIC_API_URL=http://localhost:3100

# Google sign-in: OAuth client ids from Google Cloud Console. Add the same ids
# to GOOGLE_CLIENT_IDS in apps/shelf-tracker/raf-api/.env. Leave empty to turn it off.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
