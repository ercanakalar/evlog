# Address of the Evlog API as seen from the phone.
# Android emulator: http://10.0.2.2:3000   iOS simulator: http://localhost:3000
# Physical device: http://<your-computer-LAN-IP>:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# Who runs Evlog and where users reach them. Shown in the legal texts, so a
# production build needs the real ones: full legal name with address, and an email.
EXPO_PUBLIC_LEGAL_OPERATOR=
EXPO_PUBLIC_SUPPORT_EMAIL=
