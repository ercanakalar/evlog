{
  "expo": {
    "name": "Evlog",
    "slug": "evlog",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "evlog",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "bundleIdentifier": "app.evlog.mobile",
      "supportsTablet": false
    },
    "android": {
      "package": "app.evlog.mobile",
      "adaptiveIcon": {
        "backgroundColor": "#5B5BD6",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#5B5BD6",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Evlog uses the camera to photograph rooms and to read receipts, barcodes and pack dates.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "Evlog uses the camera to photograph rooms for the condition record and to scan receipts.",
          "photosPermission": "Evlog reads receipt photos you choose from your library.",
          "microphonePermission": false
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#15181A"
        }
      ],
      [
        "expo-secure-store",
        {
          "faceIDPermission": false,
          "configureAndroidBackup": true
        }
      ],
      "expo-localization",
      "expo-font",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "reactCompiler": true
    }
  }
}
