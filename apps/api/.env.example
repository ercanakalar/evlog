NODE_ENV=development
PORT=3000
# Public base URL of this API, used to build the OCR callback URL.
PUBLIC_API_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:8081

DATABASE_URL=postgresql://evlog:evlog@localhost:5432/evlog?schema=public

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Where uploaded photos and receipt images are written.
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=12

# Your receipt reader (the YOLO service running on your computer).
OCR_SERVICE_URL=http://localhost:8000
OCR_SERVICE_TOKEN=change-me-ocr-token
# The reader sends this in X-Ocr-Secret when it calls back with results.
OCR_CALLBACK_SECRET=change-me-ocr-callback-secret-32chars
OCR_TIMEOUT_MS=20000

# How many confirmed rent receipts verify a tenancy.
RENT_RECEIPTS_TO_VERIFY=2

# Sahibinden partner (corporate) API. Leave empty for link-only mode.
SAHIBINDEN_API_URL=
SAHIBINDEN_API_KEY=
