NODE_ENV=development
PORT=3100
# Public base URL of this API, used to build the receipt reader's callback URL.
PUBLIC_API_URL=http://localhost:3100
CORS_ORIGINS=http://localhost:8081

# Raf has its own Postgres server (docker compose service "raf-db", port 5433).
# A hosted one works too, e.g. Neon's pooled address (migrations use its direct one).
DATABASE_URL=postgresql://raf:raf@localhost:5433/raf?schema=public

# Generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change-me-access-secret-at-least-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=30

# Where receipt photos are written.
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=12

# The receipt reader is built in (npm run models downloads what it needs).
OCR_MODEL_DIR=./models
# CPU threads it uses; all of them when empty.
OCR_THREADS=
OCR_TIMEOUT_MS=90000
# To use the separate reader in services/receipt-reader instead, set its address
# (http://localhost:8000). It sends the secret back in X-Ocr-Secret.
OCR_SERVICE_URL=
OCR_SERVICE_TOKEN=change-me-ocr-token
OCR_CALLBACK_SECRET=change-me-ocr-callback-secret-32chars

# Google sign-in: comma-separated OAuth client ids (web, iOS, Android) from
# Google Cloud Console. Leave empty to turn Google sign-in off.
GOOGLE_CLIENT_IDS=
