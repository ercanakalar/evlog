# Settings for scripts/setup-project.sh and scripts/deploy-manual.sh (Cloud Run).
# cp .env.production.example .env.production   (it is not committed)

# --- Google Cloud ---
PROJECT_ID=
# e.g. europe-west3 (Frankfurt); keep it close to the database.
REGION=
SERVICE=raf-tracker-backend
# Runs the database migrations before each deploy.
JOB=raf-tracker-migrate
# The identity the API runs as. Empty: the project's default compute account.
SERVICE_ACCOUNT=
# Optional. Defaults: 2 CPUs, 4Gi (the receipt reader, the API and the photo bucket
# mount share it; 2Gi runs out while reading), 0 to 2 instances.
# CPU=2
# MEMORY=4Gi
# MIN_INSTANCES=0
# MAX_INSTANCES=2
# Optional. Defaults to the service's Cloud Run address; set it for a custom domain.
# PUBLIC_API_URL=https://api.example.com

# --- Secrets: stored in Secret Manager by the deploy ---
# Neon: the pooled address; migrations use the direct one (prisma.config.ts).
DATABASE_URL=
# Any SMTP provider; percent-encode special characters in the password.
# SMTP_URL=smtps://user:password@smtp.example.com:465
SMTP_URL=
# JWT_ACCESS_SECRET is generated in Secret Manager; it does not go here.

# --- Settings ---
MAIL_FROM="Raf <no-reply@example.com>"
# Shown on /privacy, /terms and /delete-account: legal name and address, and an
# address you read.
LEGAL_OPERATOR=""
SUPPORT_EMAIL=
# Optional. Google sign-in: the web, iOS and Android OAuth client ids, comma-separated.
GOOGLE_CLIENT_IDS=
# Optional. Only browsers need it; the phone app does not.
CORS_ORIGINS=
